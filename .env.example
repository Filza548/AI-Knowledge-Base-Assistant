# Auth.js / NextAuth (min 32 chars)
AUTH_SECRET=
# App public URL — localhost for dev; set to https://YOUR_APP.vercel.app in production
AUTH_URL=http://localhost:3000

# AES-256 key: 64 hex characters (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google SSO (Auth.js) — when both are set, login shows "Continue with Google"
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Local:
#   Origins: http://localhost:3000
#   Redirect: http://localhost:3000/api/auth/callback/google
# Production (Vercel):
#   Origins: https://YOUR_APP.vercel.app
#   Redirect: https://YOUR_APP.vercel.app/api/auth/callback/google
# Google SSO — only for invited or already-approved users (not open signup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Resend for invite + approval emails
# Without these, invite links still appear in Admin Settings for copy/paste
RESEND_API_KEY=
EMAIL_FROM=AI Knowledge Base <onboarding@resend.dev>
